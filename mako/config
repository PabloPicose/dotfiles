# mako — notificaciones (Catppuccin Macchiato + azul de kitty)
# Recargar: makoctl reload · Probar: notify-send "Hola" "prueba"
# SUPER+N cierra la última · SUPER+SHIFT+N cierra todas

font=MesloLGM Nerd Font Propo 11
background-color=#24273aee
text-color=#cad3f5
border-color=#7a9ec4
progress-color=over #363a4f
border-size=2
border-radius=8
padding=10
margin=10
width=380
max-icon-size=48
anchor=top-right
layer=overlay
default-timeout=6000
max-history=20

[urgency=low]
border-color=#494d64

[urgency=high]
border-color=#f5a97f
default-timeout=0
