// Waybar — barra arriba en todos los monitores
// Recargar: pkill -x waybar  (hypr/scripts/waybar.sh lo relanza). NO usar SIGUSR2: mpris hace caer a waybar
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 6,

    "modules-left":   ["hyprland/workspaces", "hyprland/submap", "hyprland/window"],
    "modules-center": ["mpris", "clock"],
    "modules-right":  ["idle_inhibitor", "hyprland/language", "wireplumber", "network", "cpu", "memory", "custom/arctis", "custom/teams", "tray"],

    // Escritorios del monitor actual; rueda del ratón para cambiar.
    // Clic desactivado: waybar 0.15 manda "dispatch workspace N" (formato antiguo),
    // que Hyprland con config Lua rechaza. Usar SUPER+1..0.
    "hyprland/workspaces": {
        "format": "{name}",
        "disable-click": true,
        // Muestra "magic" (el scratchpad) solo mientras está visible
        "show-special": true,
        "special-visible-only": true,
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r+1\" })'"
    },

    // Muestra el modo activo (p. ej. "resize" tras SUPER+R), como el modo de vim
    "hyprland/submap": {
        "format": "-- {} --",
        "tooltip": false
    },

    "hyprland/window": {
        "max-length": 60,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A %d %B %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    // us / es (SUPER+ALT+K para cambiar)
    "hyprland/language": {
        "format": "󰌌 {short}"
    },

    // Clic: mezclador (pavucontrol) · clic derecho: silenciar · rueda: volumen
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 mute",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },

    // Música / vídeo en curso (Firefox, Spotify…). Clic: play/pausa · rueda: siguiente/anterior
    "mpris": {
        "format": "{player_icon} {title}",
        "format-paused": "{status_icon} <i>{title}</i>",
        "title-len": 45,
        // Firefox sale dos veces (MPRIS propio + integración con Plasma): se usa el de Plasma (título limpio + canal)
        "ignored-players": ["firefox"],
        "player-icons": { "default": "󰐊", "firefox": "󰈹", "spotify": "󰓇" },
        "status-icons": { "paused": "󰏤" },
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    // Red: cable o wifi; pasar el ratón muestra la IP
    "network": {
        "format-ethernet": "󰈀",
        "format-wifi": "󰖩 {essid}",
        "format-disconnected": "󰈂 sin red",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    // Clic: impedir que las pantallas se apaguen (hypridle) — p. ej. leyendo o en una presentación
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "󰅶", "deactivated": "󰾪" },
        "tooltip-format-activated": "Las pantallas NO se apagan",
        "tooltip-format-deactivated": "Las pantallas se apagan a los 15 min"
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 5
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 5
    },

    // Batería del Arctis (al lado de su icono de la bandeja, que se deja sin %). Oculto con el cascos apagado.
    // Lee asm-daemon por D-Bus; en rojo con 25 % o menos.
    "custom/arctis": {
        "exec": "~/.config/waybar/scripts/arctis.sh",
        "return-type": "json",
        "interval": 30
    },

    // Teams (app de Chrome): icono mientras está abierto, como si fuera de la bandeja; clic = ir a la ventana
    "custom/teams": {
        "exec": "~/.config/waybar/scripts/teams.sh",
        "on-click": "~/.config/waybar/scripts/teams.sh focus",
        "return-type": "json",
        "interval": 2
    },

    "tray": {
        "spacing": 8
    }
}
