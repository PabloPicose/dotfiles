# Metapaquete: todo lo que solo uso en Hyprland.
# Instalar / actualizar tras cambiar la lista:  makepkg -si
# Quitar Hyprland y todo esto (sin tocar KDE):  sudo pacman -Rns hyprland-setup
#
# No añadir aquí cosas que también uso en KDE (kitty, dolphin, polkit-kde...).
pkgname=hyprland-setup
pkgver=1
pkgrel=8
pkgdesc='Metapaquete: Hyprland y sus programas (quitar con pacman -Rns hyprland-setup)'
arch=('any')
license=('0BSD')
depends=(
  'hyprland'
  'hyprpaper'   # fondo de pantalla
  'waybar'      # barra
  'fuzzel'      # lanzador (SUPER+Space)
  'mako'        # notificaciones
  'hyprshot'    # capturas (trae grim, slurp, jq)
  'xdg-desktop-portal-hyprland'  # compartir pantalla (Teams en Firefox, Discord)
  'cliphist'    # historial del portapapeles (usa wl-clipboard, que ya se usa en KDE)
  'hypridle'    # apagar pantallas por inactividad
  'udiskie'     # montar USB automáticamente (en KDE lo hace Plasma)
  'libappindicator'  # icono de udiskie en la bandeja de waybar (--appindicator)
)

# Arctis: al entrar en KDE vuelve a 90 min (al apagar desde Hyprland se queda en 10)
source=('arctis-normal-kde.service')
sha256sums=('20ce7c6a0df4fddfe57c95455cc6c56cffab33591507d8383a5656a188f1c882')

package() {
  local dir="$pkgdir/usr/lib/systemd/user"
  install -Dm644 arctis-normal-kde.service "$dir/arctis-normal-kde.service"
  # Activado para todos los usuarios sin `systemctl enable`; se borra con el paquete
  install -d "$dir/plasma-workspace.target.wants"
  ln -s ../arctis-normal-kde.service "$dir/plasma-workspace.target.wants/arctis-normal-kde.service"
}
